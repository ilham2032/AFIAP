# Server
PORT=3001

# Partner application destination
PARTNER_EMAIL_TO=firstitassistance@gmail.com

# Site URL (used by FormSubmit on the server for live deployments)
SITE_ORIGIN=https://ilham2032.github.io/AFIAP
SITE_PARTNER_PATH=/become-a-partner

# Recommended: Web3Forms (free) — https://web3forms.com
# Sign up with firstitassistance@gmail.com, verify email, copy your access key:
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Optional: Gmail SMTP (alternative to Web3Forms)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=firstitassistance@gmail.com
SMTP_PASS=your_gmail_app_password_here
